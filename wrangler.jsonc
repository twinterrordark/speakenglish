{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "english-teacher-3d",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "not_found_handling": "none",
    "run_worker_first": ["/api/*"]
  },
  // Doğal ses (MeloTTS) için Workers AI; ücretsiz planda günlük 10.000 nöron.
  "ai": { "binding": "AI" },
  // Kişi (IP) başına dakikalık istek sınırı; ücretsiz kotayı korur.
  "ratelimits": [
    { "name": "CHAT_LIMITER", "namespace_id": "1001", "simple": { "limit": 12, "period": 60 } },
    { "name": "TTS_LIMITER", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } }
  ],
  "vars": {
    // Ücretsiz katmandaki başka bir modele geçmek için değiştirin (ör. "gemini-3.8-flash").
    // Model "minimal" desteklemiyorsa GEMINI_THINKING_LEVEL değerini "low" yapın.
    "GEMINI_MODEL": "gemini-3.5-flash-lite",
    "GEMINI_THINKING_LEVEL": "minimal",
    // Sohbet sunucusunu tarayıcıdan çağırabilecek diğer siteler (virgülle ayırın).
    "ALLOWED_ORIGINS": "https://twinterrordark.github.io"
  }
}
